rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every collection here is only used by signed-in store admins/cashiers.
    // Create Firebase Auth users in the console (Authentication -> Users);
    // there is no public sign-up flow in this app.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
